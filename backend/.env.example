# คัดลอกเป็น .env แล้วแก้ค่า — ห้าม commit ไฟล์ .env
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/indicator_map

# ต้องตั้งเอง ไม่มีค่า default — server จะไม่ start ถ้าว่าง
JWT_SECRET=
JWT_TTL=12h

UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

CORS_ORIGIN=http://localhost:5173

# ใช้ครั้งแรกตอน migrate เพื่อสร้างบัญชีแอดมิน (ลบออกหลังสร้างเสร็จ)
ADMIN_EMAIL=
ADMIN_PASSWORD=
