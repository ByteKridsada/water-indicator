# Settings for `docker compose up`. Copy to .env (same folder) and fill in every value.
# Never commit .env. Generate secrets with:  openssl rand -base64 32

# Database password (only containers use it; it is never exposed outside Docker)
POSTGRES_PASSWORD=

# Signs login tokens. Changing it logs everyone out.
JWT_SECRET=

# First admin account, created on the first run if it doesn't exist yet
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Port on this machine where the website is served: http://localhost:8080
WEB_PORT=8080
